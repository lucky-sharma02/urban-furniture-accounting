generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// AccountType mirrors shared/types.ts AccountType — keep both in sync.
enum AccountType {
  Asset
  Liability
  Bank
  Capital
  Cash
  Income
  Expenses
  OtherExpenses
}

enum ContactType {
  Vendor
  Customer
  Both
}

enum JournalType {
  Sales
  Purchase
  Bank
  Cash
}

enum JournalEntryStatus {
  Draft
  Posted
}

// Mirrors shared/types.ts JournalEntrySourceType — keep both in sync.
enum JournalEntrySourceType {
  VendorBill
  VendorPayment
  CustomerInvoice
  CustomerPayment
  Manual
}

enum PurchaseOrderStatus {
  Draft
  Billed
}

// Draft = nothing paid yet, Partial = some but not all paid, Paid = amountDue is 0.
// Shared by VendorBill and CustomerInvoice — name predates CustomerInvoice existing.
enum VendorBillStatus {
  Draft
  Partial
  Paid
}

enum SalesOrderStatus {
  Draft
  Invoiced
}

model Contact {
  id                String             @id @default(cuid())
  name              String
  type              ContactType
  email             String             @unique
  phone             String?
  address           String?
  isArchived        Boolean            @default(false)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  journalEntryLines JournalEntryLine[]
  purchaseOrders    PurchaseOrder[]
  vendorBills       VendorBill[]
  salesOrders       SalesOrder[]
  customerInvoices  CustomerInvoice[]
}

model Product {
  id                 String              @id @default(cuid())
  name               String              @unique
  category           String
  salesPrice         Decimal             @db.Decimal(12, 2)
  purchasePrice      Decimal             @db.Decimal(12, 2)
  isArchived         Boolean             @default(false)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  purchaseOrderLines PurchaseOrderLine[]
  salesOrderLines    SalesOrderLine[]
}

model Account {
  id                String             @id @default(cuid())
  name              String             @unique
  type              AccountType
  isArchived        Boolean            @default(false)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  journalEntryLines JournalEntryLine[]
  payments          Payment[]
}

model Journal {
  id             String         @id @default(cuid())
  name           String         @unique
  type           JournalType
  isArchived     Boolean        @default(false)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  journalEntries JournalEntry[]
}

model JournalEntry {
  id         String                 @id @default(cuid())
  journalId  String
  journal    Journal                @relation(fields: [journalId], references: [id])
  date       DateTime
  reference  String?
  sourceType JournalEntrySourceType
  sourceId   String
  status     JournalEntryStatus     @default(Posted)
  lines      JournalEntryLine[]
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt

  @@index([sourceType, sourceId])
}

model JournalEntryLine {
  id             String       @id @default(cuid())
  journalEntryId String
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id])
  accountId      String
  account        Account      @relation(fields: [accountId], references: [id])
  partnerId      String?
  partner        Contact?     @relation(fields: [partnerId], references: [id])
  debit          Decimal      @db.Decimal(12, 2)
  credit         Decimal      @db.Decimal(12, 2)
  createdAt      DateTime     @default(now())
}

model PurchaseOrder {
  id          String              @id @default(cuid())
  vendorId    String
  vendor      Contact             @relation(fields: [vendorId], references: [id])
  date        DateTime
  status      PurchaseOrderStatus @default(Draft)
  lines       PurchaseOrderLine[]
  vendorBills VendorBill[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

model PurchaseOrderLine {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  productId       String
  product         Product       @relation(fields: [productId], references: [id])
  quantity        Decimal       @db.Decimal(12, 2)
  unitPrice       Decimal       @db.Decimal(12, 2)
}

model VendorBill {
  id              String           @id @default(cuid())
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder?   @relation(fields: [purchaseOrderId], references: [id])
  vendorId        String
  vendor          Contact          @relation(fields: [vendorId], references: [id])
  date            DateTime
  amount          Decimal          @db.Decimal(12, 2)
  amountDue       Decimal          @db.Decimal(12, 2)
  status          VendorBillStatus @default(Draft)
  payments        Payment[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

// Exactly one of vendorBillId / customerInvoiceId is set per row — enforced at the
// application layer (each post*Payment route only ever fills in its own side).
model Payment {
  id                String           @id @default(cuid())
  vendorBillId      String?
  vendorBill        VendorBill?      @relation(fields: [vendorBillId], references: [id])
  customerInvoiceId String?
  customerInvoice   CustomerInvoice? @relation(fields: [customerInvoiceId], references: [id])
  amount            Decimal          @db.Decimal(12, 2)
  date              DateTime
  paymentAccountId  String
  paymentAccount    Account          @relation(fields: [paymentAccountId], references: [id])
  createdAt         DateTime         @default(now())
}

model SalesOrder {
  id         String            @id @default(cuid())
  customerId String
  customer   Contact           @relation(fields: [customerId], references: [id])
  date       DateTime
  status     SalesOrderStatus  @default(Draft)
  lines      SalesOrderLine[]
  invoices   CustomerInvoice[]
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
}

model SalesOrderLine {
  id           String     @id @default(cuid())
  salesOrderId String
  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id])
  productId    String
  product      Product    @relation(fields: [productId], references: [id])
  quantity     Decimal    @db.Decimal(12, 2)
  unitPrice    Decimal    @db.Decimal(12, 2)
}

model CustomerInvoice {
  id           String           @id @default(cuid())
  salesOrderId String?
  salesOrder   SalesOrder?      @relation(fields: [salesOrderId], references: [id])
  customerId   String
  customer     Contact          @relation(fields: [customerId], references: [id])
  date         DateTime
  baseAmount   Decimal          @db.Decimal(12, 2)
  taxAmount    Decimal          @db.Decimal(12, 2)
  amount       Decimal          @db.Decimal(12, 2)
  amountDue    Decimal          @db.Decimal(12, 2)
  status       VendorBillStatus @default(Draft)
  payments     Payment[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}
