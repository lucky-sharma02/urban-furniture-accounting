generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// AccountType mirrors shared/types.ts AccountType — keep both in sync.
enum AccountType {
  Asset
  Liability
  Bank
  Capital
  Cash
  Income
  Expenses
  OtherExpenses
}

enum ContactType {
  Vendor
  Customer
  Both
}

enum JournalType {
  Sales
  Purchase
  Bank
  Cash
}

enum JournalEntryStatus {
  Draft
  Posted
}

// Mirrors shared/types.ts JournalEntrySourceType — keep both in sync.
enum JournalEntrySourceType {
  VendorBill
  VendorPayment
  CustomerInvoice
  CustomerPayment
  Manual
}

enum PurchaseOrderStatus {
  Draft
  Confirmed
  Billed
}

// Draft = nothing paid yet, Partial = some but not all paid, Paid = amountDue is 0.
// Shared by VendorBill and CustomerInvoice — name predates CustomerInvoice existing.
enum VendorBillStatus {
  Draft
  Partial
  Paid
}

enum SalesOrderStatus {
  Draft
  Confirmed
  Invoiced
}

enum Role {
  Admin
  Accountant
  Contact
}

// Budget document lifecycle. Draft = editable, no tracking. Confirmed = committed
// amounts locked, "Achieved" computes, over-budget warnings fire. Revised = superseded
// by a newer revision (kept read-only for history). Cancelled = excluded everywhere.
enum BudgetStatus {
  Draft
  Confirmed
  Revised
  Cancelled
}

// A budget line targets either revenue (Income, sourced from tagged Customer Invoices)
// or spend (Expenses, sourced from tagged Vendor Bills).
enum BudgetType {
  Income
  Expenses
}

// Only meaningful for a Contact-role user whose linked Contact is type Both — it
// restricts which portal list that login sees. Null for everyone else (a pure
// Vendor/Customer contact's access is derived straight from the contact type).
enum PortalScope {
  Invoices
  Bills
  Both
}

// contactId is set only for Role.Contact users — it is exactly what portal-scope
// filtering keys every query by, so a login can never claim more than one Contact's data.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         Role
  contactId    String?      @unique
  contact      Contact?     @relation(fields: [contactId], references: [id])
  portalScope  PortalScope?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime @updatedAt
}

model Contact {
  id                String             @id @default(cuid())
  name              String
  type              ContactType
  email             String             @unique
  phone             String?
  address           String?
  isArchived        Boolean            @default(false)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  journalEntryLines JournalEntryLine[]
  purchaseOrders    PurchaseOrder[]
  vendorBills       VendorBill[]
  salesOrders       SalesOrder[]
  customerInvoices  CustomerInvoice[]
  budgets           Budget[]
  user              User?
}

model Product {
  id                 String              @id @default(cuid())
  refNumber          Int                 @unique @default(autoincrement())
  name               String              @unique
  category           String
  salesPrice         Decimal             @db.Decimal(12, 2)
  purchasePrice      Decimal             @db.Decimal(12, 2)
  isArchived         Boolean             @default(false)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  purchaseOrderLines   PurchaseOrderLine[]
  salesOrderLines      SalesOrderLine[]
  vendorBillLines      VendorBillLine[]
  customerInvoiceLines CustomerInvoiceLine[]
}

model Account {
  id                String             @id @default(cuid())
  name              String             @unique
  type              AccountType
  isArchived        Boolean            @default(false)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  journalEntryLines JournalEntryLine[]
  payments          Payment[]
}

model Journal {
  id             String         @id @default(cuid())
  name           String         @unique
  type           JournalType
  isArchived     Boolean        @default(false)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  journalEntries JournalEntry[]
}

model JournalEntry {
  id         String                 @id @default(cuid())
  journalId  String
  journal    Journal                @relation(fields: [journalId], references: [id])
  date       DateTime
  reference  String?
  sourceType JournalEntrySourceType
  sourceId   String
  status     JournalEntryStatus     @default(Posted)
  lines      JournalEntryLine[]
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt

  @@index([sourceType, sourceId])
}

model JournalEntryLine {
  id                String           @id @default(cuid())
  journalEntryId    String
  journalEntry      JournalEntry     @relation(fields: [journalEntryId], references: [id])
  accountId         String
  account           Account          @relation(fields: [accountId], references: [id])
  partnerId         String?
  partner           Contact?         @relation(fields: [partnerId], references: [id])
  analyticAccountId String?
  analyticAccount   AnalyticAccount? @relation(fields: [analyticAccountId], references: [id])
  debit             Decimal          @db.Decimal(12, 2)
  credit            Decimal          @db.Decimal(12, 2)
  createdAt         DateTime         @default(now())
}

// A tag for cost/revenue tracking independent of the Chart of Accounts (e.g. a
// project, cost centre or campaign — the "Budget Analytics" on transaction lines).
// A transaction tagged with an AnalyticAccount rolls up into any BudgetLine that
// references the same AnalyticAccount, matching type, within the budget period.
model AnalyticAccount {
  id                String             @id @default(cuid())
  name              String             @unique
  isArchived        Boolean            @default(false)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  journalEntryLines    JournalEntryLine[]
  budgetLines          BudgetLine[]
  purchaseOrderLines   PurchaseOrderLine[]
  vendorBillLines      VendorBillLine[]
  salesOrderLines      SalesOrderLine[]
  customerInvoiceLines CustomerInvoiceLine[]
}

// Header of a budget document. "Achieved" is never stored — it is always computed
// from tagged Customer Invoices / Vendor Bills within [periodStart, periodEnd].
model Budget {
  id            String       @id @default(cuid())
  name          String
  periodStart   DateTime
  periodEnd     DateTime
  responsibleId String?
  responsible   Contact?     @relation(fields: [responsibleId], references: [id])
  status        BudgetStatus @default(Draft)
  // Set on a revision, pointing at the budget it superseded (one-to-one self relation).
  revisedFromId String?      @unique
  revisedFrom   Budget?      @relation("BudgetRevision", fields: [revisedFromId], references: [id])
  revisedTo     Budget?      @relation("BudgetRevision")
  lines         BudgetLine[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model BudgetLine {
  id                String          @id @default(cuid())
  budgetId          String
  budget            Budget          @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  analyticAccountId String
  analyticAccount   AnalyticAccount @relation(fields: [analyticAccountId], references: [id])
  type              BudgetType
  committedAmount   Decimal         @db.Decimal(12, 2)
}

model PurchaseOrder {
  id          String              @id @default(cuid())
  refNumber   Int                 @unique @default(autoincrement())
  vendorId    String
  vendor      Contact             @relation(fields: [vendorId], references: [id])
  date        DateTime
  status      PurchaseOrderStatus @default(Draft)
  lines       PurchaseOrderLine[]
  vendorBills VendorBill[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

model PurchaseOrderLine {
  id                String           @id @default(cuid())
  purchaseOrderId   String
  purchaseOrder     PurchaseOrder    @relation(fields: [purchaseOrderId], references: [id])
  productId         String
  product           Product          @relation(fields: [productId], references: [id])
  analyticAccountId String?
  analyticAccount   AnalyticAccount? @relation(fields: [analyticAccountId], references: [id])
  quantity          Decimal          @db.Decimal(12, 2)
  unitPrice         Decimal          @db.Decimal(12, 2)
}

model VendorBill {
  id              String           @id @default(cuid())
  refNumber       Int              @unique @default(autoincrement())
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder?   @relation(fields: [purchaseOrderId], references: [id])
  vendorId        String
  vendor          Contact          @relation(fields: [vendorId], references: [id])
  date            DateTime
  dueDate         DateTime?
  reference       String?
  amount          Decimal          @db.Decimal(12, 2)
  amountDue       Decimal          @db.Decimal(12, 2)
  status          VendorBillStatus @default(Draft)
  lines           VendorBillLine[]
  payments        Payment[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model VendorBillLine {
  id                String           @id @default(cuid())
  vendorBillId      String
  vendorBill        VendorBill       @relation(fields: [vendorBillId], references: [id], onDelete: Cascade)
  productId         String
  product           Product          @relation(fields: [productId], references: [id])
  analyticAccountId String?
  analyticAccount   AnalyticAccount? @relation(fields: [analyticAccountId], references: [id])
  quantity          Decimal          @db.Decimal(12, 2)
  unitPrice         Decimal          @db.Decimal(12, 2)
}

// Exactly one of vendorBillId / customerInvoiceId is set per row — enforced at the
// application layer (each post*Payment route only ever fills in its own side).
model Payment {
  id                String           @id @default(cuid())
  refNumber         Int              @unique @default(autoincrement())
  vendorBillId      String?
  vendorBill        VendorBill?      @relation(fields: [vendorBillId], references: [id])
  customerInvoiceId String?
  customerInvoice   CustomerInvoice? @relation(fields: [customerInvoiceId], references: [id])
  amount            Decimal          @db.Decimal(12, 2)
  date              DateTime
  paymentAccountId  String
  paymentAccount    Account          @relation(fields: [paymentAccountId], references: [id])
  createdAt         DateTime         @default(now())
}

model SalesOrder {
  id         String            @id @default(cuid())
  refNumber  Int               @unique @default(autoincrement())
  customerId String
  customer   Contact           @relation(fields: [customerId], references: [id])
  date       DateTime
  status     SalesOrderStatus  @default(Draft)
  lines      SalesOrderLine[]
  invoices   CustomerInvoice[]
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
}

model SalesOrderLine {
  id                String           @id @default(cuid())
  salesOrderId      String
  salesOrder        SalesOrder       @relation(fields: [salesOrderId], references: [id])
  productId         String
  product           Product          @relation(fields: [productId], references: [id])
  analyticAccountId String?
  analyticAccount   AnalyticAccount? @relation(fields: [analyticAccountId], references: [id])
  quantity          Decimal          @db.Decimal(12, 2)
  unitPrice         Decimal          @db.Decimal(12, 2)
}

model CustomerInvoice {
  id           String                @id @default(cuid())
  refNumber    Int                   @unique @default(autoincrement())
  salesOrderId String?
  salesOrder   SalesOrder?           @relation(fields: [salesOrderId], references: [id])
  customerId   String
  customer     Contact               @relation(fields: [customerId], references: [id])
  date         DateTime
  dueDate      DateTime?
  reference    String?
  baseAmount   Decimal               @db.Decimal(12, 2)
  taxAmount    Decimal               @db.Decimal(12, 2)
  amount       Decimal               @db.Decimal(12, 2)
  amountDue    Decimal               @db.Decimal(12, 2)
  status       VendorBillStatus      @default(Draft)
  lines        CustomerInvoiceLine[]
  payments     Payment[]
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
}

model CustomerInvoiceLine {
  id                String           @id @default(cuid())
  customerInvoiceId String
  customerInvoice   CustomerInvoice  @relation(fields: [customerInvoiceId], references: [id], onDelete: Cascade)
  productId         String
  product           Product          @relation(fields: [productId], references: [id])
  analyticAccountId String?
  analyticAccount   AnalyticAccount? @relation(fields: [analyticAccountId], references: [id])
  quantity          Decimal          @db.Decimal(12, 2)
  unitPrice         Decimal          @db.Decimal(12, 2)
}
